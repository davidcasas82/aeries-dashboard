{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/deny-dangerous-shell.sh",
        "matcher": "[\\s\\S]*([Ll][Aa][Uu][Nn][Cc][Hh][Cc][Tt][Ll]|[Ss][Uu][Dd][Oo]|[Rr][Ee][Bb][Oo][Oo][Tt]|[Ss][Hh][Uu][Tt][Dd][Oo][Ww][Nn]|[Hh][Aa][Ll][Tt]|[Pp][Mm][Ss][Ee][Tt]|[Ll][Aa][Uu][Nn][Cc][Hh][Aa][Gg][Ee][Nn][Tt][Ss]|[Ll][Aa][Uu][Nn][Cc][Hh][Dd][Aa][Ee][Mm][Oo][Nn][Ss])[\\s\\S]*",
        "timeout": 10,
        "failClosed": true
      }
    ]
  }
}
