# Aeries parent-portal login (required for scrape)
AERIES_EMAIL=parent@example.com
AERIES_PASSWORD=your_password_here

# Students (SN is the Aeries student number used in ChangeStudent.aspx)
# Repeat STUDENT_2_*, STUDENT_3_*, … as needed
STUDENT_1_SN=1234
STUDENT_1_NAME=Kid1FirstName
STUDENT_1_SCHOOL_CODE=95

STUDENT_2_SN=5678
STUDENT_2_NAME=Kid2FirstName
STUDENT_2_SCHOOL_CODE=95

# Optional: Grok briefings (https://console.x.ai/)
GROK_API_KEY=

# Optional overrides
# true = force pause Aeries + Grok; false = scrape even in summer
# SUMMER_BREAK=
# SKIP_CALENDAR_REFRESH=true
